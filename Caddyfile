# The studio on app.local.pollar.studio with HTTPS, the local twin of
# app.pollar.studio. HTTPS is required: the session cookie is Secure and
# https://app.local.pollar.studio/auth/callback is the redirect URI hub-api
# registers for local sign-in. Needs a 127.0.0.1 line for the host in /etc/hosts.

app.local.pollar.studio:443 {
    tls internal
    reverse_proxy localhost:3000
}

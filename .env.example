# ---------------------------------------------------------------------------
# Runtime environment (Dokploy: Environment)
# Read by the server on every request; a change takes effect on restart.
# ---------------------------------------------------------------------------

# Select a model enabled in your Gateway account.
AI_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_API_KEY=
AI_MODEL=moonshotai/kimi-k3

# For Ollama, replace AI_BASE_URL with http://localhost:11434/v1
# and AI_MODEL with an installed model. Set AI_API_KEY if your proxy requires it.

# ---------------------------------------------------------------------------
# Build-time arguments (Dokploy: Build-time Arguments)
# Next.js inlines NEXT_PUBLIC_* into the client bundle during `pnpm build`, so a
# change needs a rebuild. The Dockerfile receives each one through an ARG in
# the builder stage.
# ---------------------------------------------------------------------------

# hub-api, the same backend the dashboard signs into. This origin must be in its
# API_CORS_ORIGINS for the login, Google and passkeys to work.
NEXT_PUBLIC_HUB_API_URL=http://localhost:3051

# ---------------------------------------------------------------------------
# Build-time secrets (Dokploy: Build-time Secrets)
# None: the build reads no secret.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Runtime environment (Dokploy: Environment)
# Read by the server on every request; a change takes effect on restart.
# All required. The browser never sees any of them.
# ---------------------------------------------------------------------------

# Server-only Studio API. Route handlers forward the session's access token upstream.
STUDIO_API_BASE_URL=https://api-studio.pollar.studio

# The hub-api OIDC issuer, exactly as its discovery document states it.
OIDC_ISSUER=https://accounts.local.pollar.xyz/oidc
# This app's client on the issuer.
OIDC_CLIENT_ID=studio
# The `studio` client secret; hub-api holds the same value as OIDC_CLIENT_SECRET_STUDIO.
OIDC_CLIENT_SECRET=
# Resource indicator the access token is issued for (its `aud`), hub-api's OIDC_HUB_RESOURCE. Prod: https://hub.api.pollar.xyz
OIDC_HUB_RESOURCE=https://hub.api.local.pollar.xyz
# Encrypts the session cookie; 32+ random characters (openssl rand -base64 48). Rotating it signs everyone out.
STUDIO_SESSION_SECRET=
# The origin users open; the callback and post-logout URIs registered on hub-api derive from it.
STUDIO_PUBLIC_URL=https://app.local.pollar.studio

# ---------------------------------------------------------------------------
# Build-time arguments and secrets (Dokploy: Build-time Arguments / Secrets)
# None: the build reads no variable.
# ---------------------------------------------------------------------------

# Local development only (ignored unless NODE_ENV=development): a token api-studio
# accepts, sent instead of the session's. Never commit an actual token.
STUDIO_DEV_TOKEN=
